CONFIG_WIL6210=m
CONFIG_ZD1211RW=m
CONFIG_MT7601U=m
CONFIG_MT76_CORE=m
CONFIG_MT76_USB=m
CONFIG_MT76_SDIO=m
CONFIG_MT76_CONNAC_LIB=m
CONFIG_MT7915E=m
CONFIG_MT7921_COMMON=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7921S=m
CONFIG_MT7925_COMMON=m
CONFIG_MT7925E=m
CONFIG_MT7925U=m
CONFIG_MT7996E=m
CONFIG_MT7603E=m
CONFIG_MT7615E=m
CONFIG_MT7663U=m
CONFIG_MT7663S=m
CONFIG_MT76x0U=m
CONFIG_MT76x0E=m
CONFIG_MT76x2U=m
CONFIG_MT76x2E=m
CONFIG_RTL8XXXU=m
CONFIG_RTLWIFI=m
CONFIG_RTLWIFI_PCI=m
CONFIG_RTLWIFI_USB=m
CONFIG_RTL8192CE=m
CONFIG_RTL8192CU=m
CONFIG_RTL8192DE=m
CONFIG_RTL8192SE=m
CONFIG_RTL8188EE=m
CONFIG_RTL8723AE=m
CONFIG_RTL8723BE=m
CONFIG_RTL8821AE=m
CONFIG_RTW88=m
CONFIG_RTW88_CORE=m
CONFIG_RTW88_PCI=m
# NOTE: no RTW88_SDIO / RTW88_8703B — 6.12.111 olddefconfig will not retain
# them (vanish even when forced, unlike their identical siblings; verified
# over multiple isolated probes). Realtek SDIO + RTL8703B stay unsupported;
# the ISO build skips absent modules gracefully. Revisit on the next point
# release.
CONFIG_RTW88_USB=m
CONFIG_RTW89=m
CONFIG_RTW89_CORE=m
CONFIG_RTW89_PCI=m
CONFIG_BRCMSMAC=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_USB=y
CONFIG_B43=m
CONFIG_B43LEGACY=m
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_PCIE=m
CONFIG_MWIFIEX_USB=m
CONFIG_MWIFIEX_SDIO=m
CONFIG_LIBERTAS=m
CONFIG_LIBERTAS_THINFIRM=m
CONFIG_LIBERTAS_THINFIRM_USB=m
CONFIG_LIBERTAS_SDIO=m
CONFIG_LIBERTAS_USB=m
CONFIG_MWL8K=m
CONFIG_WL1251=m
CONFIG_WL1251_SDIO=m
CONFIG_WL1251_SPI=m
CONFIG_WL12XX=m
CONFIG_WL18XX=m
CONFIG_WLCORE=m
CONFIG_WLCORE_SDIO=m
# NOTE: no WLCORE_SPI — needs devicetree (OF), Silen is x86_64 UEFI
CONFIG_P54_COMMON=m
CONFIG_P54_PCI=m
CONFIG_P54_USB=m
CONFIG_ADM8211=m
CONFIG_AT76C50X_USB=m
CONFIG_RSI_91X=m
CONFIG_RSI_USB=m
CONFIG_RSI_SDIO=m
CONFIG_WFX=m
CONFIG_WILC1000=m
CONFIG_WILC1000_SDIO=m
CONFIG_WILC1000_SPI=m
CONFIG_RT2X00=m
CONFIG_RT2400PCI=m
CONFIG_RT2500PCI=m
