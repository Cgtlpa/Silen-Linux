# Silen Linux kernel fragment — 6.12 LTS, compiled for Silen.
# Applied over pristine `make defconfig` with:
#   scripts/kconfig/merge_config.sh -m .config silen.fragment
#   make olddefconfig
# Goal: every machine boots to a working TUI/CLI (broad drivers as
# modules), the console always works (builtin simpledrm/fbcon, zero GPU
# modules needed live), and firmware/module compression match what the
# Silen ISO ships (.zst). Upstream defaults are kept wherever Silen has
# no reason to differ (scheduler, HZ, security) — boring is reliable.

# identity / debuggability
CONFIG_LOCALVERSION="-1-silen"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# modules + firmware match ISO conventions (.ko.zst, .fw.zst)
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# console/display: TUI works with zero GPU modules (builtin simpledrm)
CONFIG_VT=y
CONFIG_VGA_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_EFI=y
# CONFIG_FB_VESA is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_EFIVAR_FS=y

# early boot (OpenRC + live initramfs)
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# storage (mirrors ISO ALLOW list)
CONFIG_SATA_AHCI=m
CONFIG_ATA_PIIX=m
CONFIG_BLK_DEV_SD=m
CONFIG_BLK_DEV_SR=m
CONFIG_BLK_DEV_NVME=m
CONFIG_VMD=m
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MMC_SDHCI_ACPI=m
CONFIG_VIRTIO_BLK=m
CONFIG_SCSI_VIRTIO=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_BLK_DEV_DM=m
CONFIG_BLK_DEV_MD=m

# usb / input (CONFIG_SPI=y: bus drivers below need it)
CONFIG_SPI=y
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_EHCI_PCI=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_OHCI_HCD_PCI=m
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m
CONFIG_SERIO_I8042=m
CONFIG_KEYBOARD_ATKBD=m
CONFIG_MOUSE_PS2=m

# filesystems (mirrors ISO ALLOW list)
CONFIG_EXT4_FS=m
CONFIG_FUSE_FS=m
CONFIG_MSDOS_FS=m
CONFIG_VFAT_FS=m
CONFIG_SQUASHFS=m
CONFIG_ISO9660_FS=m
CONFIG_NTFS3_FS=m
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NLS_UTF8=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m

# wired ethernet (mirrors ISO ALLOW list)
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_R8169=m
CONFIG_TIGON3=m
CONFIG_IGB=m
CONFIG_IXGBE=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_ALX=m
CONFIG_8139TOO=m
CONFIG_VIA_RHINE=m
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_CONSOLE=m
CONFIG_VIRTIO_INPUT=m

# wireless core
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_IPW2100=m
CONFIG_IPW2200=m
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH5K=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH10K_SDIO=m
CONFIG_ATH10K_USB=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_ATH6KL=m
CONFIG_ATH6KL_USB=m
CONFIG_ATH6KL_SDIO=m
CONFIG_CARL9170=m
