# i2c controllers (touchpads, sensors on modern laptops)
CONFIG_COMMON_CLK=y
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_I801=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_NFORCE2=m
CONFIG_I2C_AMD_MP2=m
CONFIG_I2C_PIIX4=m

# hid extras (touchpads, Apple/Logitech/Microsoft inputs)
CONFIG_I2C_HID=m
CONFIG_I2C_HID_ACPI=m
